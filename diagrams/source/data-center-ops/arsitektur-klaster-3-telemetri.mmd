        MetricStore[("DB Metrik dc_metric_reading")]
        CctvProbe["Stream Probe & Health Check"]
        CctvStore[("DB CCTV dc_cctv_camera")]
    end

    subgraph Frontend["Antarmuka Pengguna (NOC Dashboard)"]
        DashView["Dashboard Overview (/dc)"]
