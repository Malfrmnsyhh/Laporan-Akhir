        Camera["Kamera CCTV / NVR Lorong"]
    end

    subgraph Backend["Modul Backend DataCenterOps"]
        Ingest["API Key Ingest (iot/metric-readings)"]
        Eval["Engine Evaluasi Ambang Batas (ASHRAE)"]
